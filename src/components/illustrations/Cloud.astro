---
interface Props {
  class?: string;
  /** Decorative only — never announced. */
  color?: string;
}

const { class: className = '', color = 'var(--color-canvas-pure)' } = Astro.props;
---

<svg viewBox="0 0 96 48" fill="none" aria-hidden="true" class={className}>
  <g fill={color}>
    <ellipse cx="48" cy="36" rx="42" ry="12" />
    <circle cx="34" cy="24" r="18" />
    <circle cx="58" cy="27" r="14" />
    <circle cx="72" cy="32" r="10" />
  </g>
</svg>
