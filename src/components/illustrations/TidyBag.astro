---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const uid = 'tidy';
---

<svg
  viewBox="0 0 300 240"
  fill="none"
  role="img"
  aria-label="A neatly packed clay bag with three folded items inside"
  class={className}
>
  <defs>
    <linearGradient id={`${uid}-bag`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#a8dfc9" />
      <stop offset="1" stop-color="#6cb69b" />
    </linearGradient>
  </defs>

  <ellipse cx="150" cy="214" rx="112" ry="18" fill="#1c1b18" opacity="0.06" />

  <!-- Handle -->
  <path
    d="M110 106c0-16 12-28 28-28h24c16 0 28 12 28 28"
    stroke="#4a806b"
    stroke-width="11"
    stroke-linecap="round"
    fill="none"
  />

  <!-- Bag -->
  <path
    d="M64 128c0-13 11-23 24-23h124c13 0 24 10 24 23v44c0 22-18 40-40 40h-92c-22 0-40-18-40-40v-44Z"
    fill={`url(#${uid}-bag)`}
  />

  <!-- Neat rolled contents -->
  <rect x="88" y="146" width="34" height="42" rx="16" fill="#fffdf8" opacity="0.85" />
  <rect x="132" y="146" width="34" height="42" rx="16" fill="#f7cf72" />
  <rect x="176" y="146" width="34" height="42" rx="16" fill="#9ecbe8" />

  <!-- Clean zipper -->
  <path d="M70 132h160" stroke="#3f6f5c" stroke-width="6" stroke-linecap="round" />

  <!-- Approval tick -->
  <circle cx="238" cy="86" r="24" fill="#f7cf72" />
  <path
    d="m228 87 7 7 13-15"
    stroke="#473205"
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
