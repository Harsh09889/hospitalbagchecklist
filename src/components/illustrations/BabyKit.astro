---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const uid = 'baby';
---

<svg
  viewBox="0 0 400 300"
  fill="none"
  role="img"
  aria-label="A clay newborn bodysuit, rolled swaddle, tiny socks and a knitted hat"
  class={className}
>
  <defs>
    <linearGradient id={`${uid}-suit`} x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0" stop-color="#ffe3ad" />
      <stop offset="1" stop-color="#f2bf5c" />
    </linearGradient>
    <linearGradient id={`${uid}-swaddle`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#a8dfc9" />
      <stop offset="1" stop-color="#6cb69b" />
    </linearGradient>
    <linearGradient id={`${uid}-hat`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#f9b8c8" />
      <stop offset="1" stop-color="#e17e9b" />
    </linearGradient>
    <linearGradient id={`${uid}-sock`} x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0" stop-color="#b8dcf1" />
      <stop offset="1" stop-color="#84b9dc" />
    </linearGradient>
  </defs>

  <ellipse cx="200" cy="266" rx="160" ry="22" fill="#1c1b18" opacity="0.06" />

  <!-- Bodysuit -->
  <g>
    <path
      d="M150 92c0-10 9-18 20-18h48c11 0 20 8 20 18v6l26 14c8 4 11 14 6 22l-8 13c-4 7-13 9-20 5l-8-4v56c0 11-9 20-20 20h-44c-11 0-20-9-20-20v-56l-8 4c-7 4-16 2-20-5l-8-13c-5-8-2-18 6-22l26-14v-6Z"
      fill={`url(#${uid}-suit)`}
    />
    <path
      d="M148 148h96M148 176h96"
      stroke="#d19b34"
      stroke-width="7"
      stroke-linecap="round"
      opacity="0.45"
    />
    <circle cx="180" cy="214" r="7" fill="#fffdf8" opacity="0.8" />
    <circle cx="212" cy="214" r="7" fill="#fffdf8" opacity="0.8" />
  </g>

  <!-- Rolled swaddle -->
  <g>
    <rect x="40" y="176" width="86" height="72" rx="34" fill={`url(#${uid}-swaddle)`} />
    <path
      d="M83 194a16 16 0 0 1 0 32 22 22 0 0 0 0-32Z"
      fill="#fffdf8"
      opacity="0.55"
    />
    <circle cx="83" cy="210" r="8" fill="#4f9a7f" opacity="0.6" />
  </g>

  <!-- Knitted hat -->
  <g>
    <path d="M282 190a34 34 0 0 1 68 0v6h-68v-6Z" fill={`url(#${uid}-hat)`} />
    <rect x="276" y="194" width="80" height="20" rx="10" fill="#c9648a" />
    <circle cx="316" cy="150" r="11" fill="#f9b8c8" />
  </g>

  <!-- Tiny socks -->
  <g>
    <path
      d="M268 226h24v14c0 9 7 12 14 12h6v14h-14c-16 0-30-11-30-26v-14Z"
      fill={`url(#${uid}-sock)`}
    />
    <path
      d="M320 226h24v14c0 9 7 12 14 12h6v14h-14c-16 0-30-11-30-26v-14Z"
      fill={`url(#${uid}-sock)`}
    />
  </g>

  <!-- Floating props -->
  <circle cx="70" cy="88" r="13" fill="#f7cf72" />
  <circle cx="330" cy="80" r="9" fill="#b9a8e8" />
  <circle cx="108" cy="130" r="7" fill="#f4907c" />
</svg>
