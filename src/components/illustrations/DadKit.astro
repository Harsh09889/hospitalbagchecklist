---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const uid = 'dad';
---

<svg
  viewBox="0 0 400 300"
  fill="none"
  role="img"
  aria-label="A clay backpack with a phone, charger, wallet and snack bar"
  class={className}
>
  <defs>
    <linearGradient id={`${uid}-pack`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#8fb8d6" />
      <stop offset="1" stop-color="#4d7f9f" />
    </linearGradient>
    <linearGradient id={`${uid}-pocket`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#f9b3a3" />
      <stop offset="1" stop-color="#e07b62" />
    </linearGradient>
    <linearGradient id={`${uid}-phone`} x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0" stop-color="#3c3a34" />
      <stop offset="1" stop-color="#1c1b18" />
    </linearGradient>
    <linearGradient id={`${uid}-wallet`} x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0" stop-color="#f2bf5c" />
      <stop offset="1" stop-color="#cf9426" />
    </linearGradient>
  </defs>

  <ellipse cx="200" cy="266" rx="158" ry="22" fill="#1c1b18" opacity="0.06" />

  <!-- Backpack -->
  <g>
    <path
      d="M118 118c0-30 24-54 54-54h20c30 0 54 24 54 54v96c0 18-14 32-32 32h-64c-18 0-32-14-32-32v-96Z"
      fill={`url(#${uid}-pack)`}
    />
    <path
      d="M150 82c0-16 13-28 29-28h6c16 0 29 12 29 28"
      stroke="#3a6a88"
      stroke-width="12"
      stroke-linecap="round"
    />
    <rect x="140" y="162" width="100" height="62" rx="24" fill={`url(#${uid}-pocket)`} />
    <path d="M156 192h68" stroke="#fffdf8" stroke-width="7" stroke-linecap="round" opacity="0.6" />
    <rect x="152" y="104" width="76" height="16" rx="8" fill="#fffdf8" opacity="0.35" />
  </g>

  <!-- Phone -->
  <g>
    <rect x="272" y="132" width="58" height="100" rx="16" fill={`url(#${uid}-phone)`} />
    <rect x="280" y="142" width="42" height="72" rx="9" fill="#8fd3bd" />
    <rect x="292" y="220" width="18" height="5" rx="2.5" fill="#fffdf8" opacity="0.5" />
  </g>

  <!-- Charger cable -->
  <path
    d="M300 130c0-24-38-20-38-44s28-22 28-40"
    stroke="#b9a8e8"
    stroke-width="9"
    stroke-linecap="round"
  />

  <!-- Wallet -->
  <g>
    <rect x="52" y="182" width="82" height="56" rx="18" fill={`url(#${uid}-wallet)`} />
    <rect x="66" y="200" width="40" height="10" rx="5" fill="#fffdf8" opacity="0.7" />
    <circle cx="120" cy="210" r="8" fill="#8a6210" opacity="0.5" />
  </g>

  <!-- Snack bar -->
  <g transform="rotate(-14 90 132)">
    <rect x="56" y="116" width="72" height="30" rx="14" fill="#b7cf9a" />
    <path
      d="M72 131h40"
      stroke="#4b6b2f"
      stroke-width="5"
      stroke-linecap="round"
      opacity="0.6"
    />
  </g>

  <circle cx="356" cy="96" r="10" fill="#f7cf72" />
</svg>
