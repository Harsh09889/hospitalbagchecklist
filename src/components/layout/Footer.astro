---
import Logo from './Logo.astro';
import { FOOTER_COLUMNS, MEDICAL_DISCLAIMER, ROUTES, SITE } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-hairline bg-surface-soft no-print">
  <div class="container-page py-14 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(4,1fr)]">
      <div>
        <a href="/" class="rounded-full" aria-label="Hospital Bag Checklist — home">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          {SITE.tagline} A simple checklist for mom, baby and dad — so you know exactly what to
          pack before the big day.
        </p>
        <p class="mt-4 text-xs text-muted-soft">{SITE.domain}</p>
      </div>

      {
        FOOTER_COLUMNS.map((column) => (
          <div>
            <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-muted-soft">
              {column.heading}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-body transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 border-t border-hairline pt-8">
      <p class="max-w-3xl text-xs leading-relaxed text-muted-soft">
        <strong class="font-semibold text-muted">Medical disclaimer.</strong> {MEDICAL_DISCLAIMER}
      </p>
      <p class="mt-4 text-xs text-muted-soft">
        &copy; {year} {SITE.domain}. All rights reserved.
      </p>
      <nav aria-label="Legal" class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-soft">
        <a href={ROUTES.privacy.path} class="transition-colors hover:text-muted">Privacy Policy</a>
        <span aria-hidden="true">&middot;</span>
        <a href={ROUTES.terms.path} class="transition-colors hover:text-muted">Terms &amp; Conditions</a>
        <span aria-hidden="true">&middot;</span>
        <a href={ROUTES.contact.path} class="transition-colors hover:text-muted">Contact Us</a>
      </nav>
    </div>
  </div>
</footer>
