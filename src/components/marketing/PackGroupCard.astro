---
import { ACCENTS } from '../../lib/accents';
import type { PackGroup } from '../../data/content/checklists';

interface Props {
  group: PackGroup;
  /** Index shown as an ordinal chip, e.g. 01. */
  index?: number;
  /** Truncate the list — used on the homepage, where the full list lives on its own page. */
  limit?: number;
  /** Where "see the full list" points when the list is truncated. */
  moreHref?: string;
}

const { group, index, limit, moreHref } = Astro.props;
const accent = ACCENTS[group.accent];

const items = limit ? group.items.slice(0, limit) : group.items;
const remaining = group.items.length - items.length;
---

<div class="card flex h-full flex-col p-6 sm:p-8 print-section">
  <div class="flex items-start gap-3">
    {
      index !== undefined && (
        <span
          class={`inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold ${accent.fill} ${accent.onFill}`}
        >
          {String(index).padStart(2, '0')}
        </span>
      )
    }
    <div>
      <h3 class="display-sm">{group.title}</h3>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{group.intro}</p>
    </div>
  </div>

  <ul class="mt-6 flex-1 space-y-3 border-t border-hairline pt-6">
    {
      items.map((item) => (
        <li class="flex items-start gap-3">
          <span
            class={`mt-[0.45rem] h-2 w-2 shrink-0 rounded-full ${accent.dot}`}
            aria-hidden="true"
          />
          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <span class="text-[0.9375rem] font-medium text-body-strong">{item.name}</span>
              {item.qty && (
                <span class={`pill ${accent.wash} text-body-strong`}>{item.qty}</span>
              )}
            </span>
            {item.note && <span class="mt-0.5 block text-sm text-muted">{item.note}</span>}
          </span>
        </li>
      ))
    }
  </ul>

  {
    remaining > 0 && moreHref && (
      <a href={moreHref} class="link-arrow mt-5 no-print">
        {`+ ${remaining} more`}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</div>
