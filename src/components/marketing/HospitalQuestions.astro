---
import { HOSPITAL_QUESTIONS } from '../../data/content/checklists';

interface Props {
  /** Limit the list, e.g. on the homepage where the full set lives elsewhere. */
  limit?: number;
}

const { limit } = Astro.props;
const questions = limit ? HOSPITAL_QUESTIONS.slice(0, limit) : HOSPITAL_QUESTIONS;
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    questions.map((entry) => (
      <li class="card flex gap-3.5 p-5 print-section">
        <span
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-sky/25 font-display text-sm font-semibold text-on-sky"
          aria-hidden="true"
        >
          ?
        </span>
        <span>
          <span class="block text-[0.9375rem] font-semibold leading-snug text-ink">
            {entry.question}
          </span>
          <span class="mt-1 block text-sm leading-relaxed text-muted">{entry.why}</span>
        </span>
      </li>
    ))
  }
</ul>
