---
interface Props {
  trail: { name: string; path: string }[];
}

const { trail } = Astro.props;
const last = trail.length - 1;
---

<nav aria-label="Breadcrumb" class="no-print">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
    {
      trail.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index === last ? (
            <span aria-current="page" class="font-medium text-body-strong">
              {crumb.name}
            </span>
          ) : (
            <>
              <a href={crumb.path} class="transition-colors hover:text-ink">
                {crumb.name}
              </a>
              <span aria-hidden="true" class="text-muted-soft">/</span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>
