---
import { ROUTES } from '../../config/site';
import LaborKit from '../illustrations/LaborKit.astro';
import CSectionKit from '../illustrations/CSectionKit.astro';
---

<div class="grid gap-4 md:grid-cols-2">
  <article class="card-feature reveal flex flex-col bg-brand-butter text-on-butter">
    <LaborKit class="h-40 w-full" />
    <h3 class="mt-6 font-display text-2xl font-medium">Vaginal birth &amp; labor</h3>
    <p class="mt-3 flex-1 leading-relaxed opacity-90">
      Pack a small labor bag for the delivery room and a larger bag for the ward. Most stays are
      one to two nights, so a couple of changes of clothes is usually enough.
    </p>
    <a href={ROUTES.labor.path} class="btn-on-color mt-7 self-start">
      Explore the labor checklist
      <span aria-hidden="true">&rarr;</span>
    </a>
  </article>

  <article class="card-feature reveal flex flex-col bg-brand-mint text-on-mint">
    <CSectionKit class="h-40 w-full" />
    <h3 class="mt-6 font-display text-2xl font-medium">C-section</h3>
    <p class="mt-3 flex-1 leading-relaxed opacity-90">
      Plan for a slightly longer stay and clothing that avoids your incision — high-waisted
      underwear, loose nightdresses and shoes you can slip on without bending.
    </p>
    <a href={ROUTES.csection.path} class="btn-on-color mt-7 self-start">
      Explore the C-section checklist
      <span aria-hidden="true">&rarr;</span>
    </a>
  </article>
</div>
