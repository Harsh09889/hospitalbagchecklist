---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTENT_ROUTE_KEYS, PRIMARY_CTA, ROUTES } from '../config/site';
import { accentAt } from '../lib/accents';
import OverpackedBag from '../components/illustrations/OverpackedBag.astro';
---

<BaseLayout
  title="Something went wrong — Hospital Bag Checklist"
  description="A server error occurred. Try again or browse our hospital bag checklists for mom, baby and dad."
  path="/500"
  noindex
>
  <section class="sky-wash">
    <div class="container-page py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <OverpackedBag class="mx-auto h-40 w-full max-w-xs" />
        <p class="eyebrow mt-8 justify-center">Error 500</p>
        <h1 class="display-xl mt-4">Something went wrong on our end.</h1>
        <p class="lead mx-auto mt-5 max-w-lg">
          We hit an unexpected problem. Please try again in a moment, or head back to a working
          page below.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn-primary btn-lg">
            Back to the hospital bag checklist
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={PRIMARY_CTA.href} class="btn-secondary btn-lg">{PRIMARY_CTA.label}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <h2 class="display-lg">Popular checklists and guides</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          CONTENT_ROUTE_KEYS.slice(0, 6).map((key, index) => {
            const route = ROUTES[key];
            const accent = accentAt(index);
            return (
              <li>
                <a href={route.path} class="card flex h-full flex-col p-6">
                  <span class={`h-1.5 w-10 rounded-full ${accent.dot}`} aria-hidden="true"></span>
                  <span class="mt-4 font-display text-lg font-medium text-ink">{route.label}</span>
                  <span class="mt-2 flex-1 text-sm leading-relaxed text-muted">
                    {route.description}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>
