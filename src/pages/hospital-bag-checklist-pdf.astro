---
import ContentPage from '../layouts/ContentPage.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import PrintableKit from '../components/illustrations/PrintableKit.astro';
import { SITE } from '../config/site';
import {
  MOM_GROUPS,
  BABY_GROUPS,
  DAD_GROUPS,
  DOCUMENT_GROUP,
  HOSPITAL_QUESTIONS,
} from '../data/content/checklists';
import { PDF_FAQS } from '../data/content/faqs';

const sheets = [
  { heading: 'Mom', groups: MOM_GROUPS },
  { heading: 'Baby', groups: BABY_GROUPS },
  { heading: 'Dad & birth partner', groups: DAD_GROUPS },
  { heading: 'Documents', groups: [DOCUMENT_GROUP] },
];

const allGroups = [...MOM_GROUPS, ...BABY_GROUPS, ...DAD_GROUPS, DOCUMENT_GROUP];
const totalItems = allGroups.reduce((sum, group) => sum + group.items.length, 0);

const contents = [
  { label: 'Print or save', href: '#print' },
  { label: 'The full checklist', href: '#sheet' },
  { label: 'FAQs', href: '#faq' },
];
---

<ContentPage
  routeKey="pdf"
  h1="Printable Hospital Bag Checklist"
  lead={`A free printable hospital bag checklist for mom, baby and dad — ${totalItems} items across four bags, with suggested quantities. Print it, stick it on the fridge, or save it as a PDF and share it with your partner.`}
  groups={allGroups}
  faqs={PDF_FAQS}
  related={['mom', 'baby', 'dad']}
  contents={contents}
  ctaTitle="Prefer a personalised list?"
  ctaLead="Answer a few questions and get a checklist tailored to your delivery plan, hospital stay and who you are packing for — then print that instead."
>
  <PrintableKit slot="illustration" class="w-full max-w-md lg:ml-auto" />

  <!-- How to print -->
  <section id="print" class="section no-print">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-16">
        <SectionHeader
          eyebrow="Two ways to use it"
          title="Print it, or save it as a PDF"
          lead="There is nothing to sign up for and no email required. Use the button below and choose your printer, or select “Save as PDF” in the print dialog to keep a digital copy."
        />

        <div class="card p-6 sm:p-8">
          <button type="button" class="btn-primary btn-lg w-full" data-print-checklist>
            Print or save as PDF
          </button>

          <ol class="mt-7 space-y-4 border-t border-hairline pt-7">
            <li class="flex gap-3.5">
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-butter text-xs font-semibold text-on-butter"
                >1</span
              >
              <span class="text-[0.9375rem] leading-relaxed text-body">
                Press the button above, or use <strong>Ctrl</strong>/<strong>Cmd</strong> +
                <strong>P</strong>.
              </span>
            </li>
            <li class="flex gap-3.5">
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-mint text-xs font-semibold text-on-mint"
                >2</span
              >
              <span class="text-[0.9375rem] leading-relaxed text-body">
                Choose your printer, or pick <strong>Save as PDF</strong> as the destination.
              </span>
            </li>
            <li class="flex gap-3.5">
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-sky text-xs font-semibold text-on-sky"
                >3</span
              >
              <span class="text-[0.9375rem] leading-relaxed text-body">
                To fit more on a page, set the scale to around <strong>70%</strong>.
              </span>
            </li>
          </ol>

          <p class="mt-6 text-xs leading-relaxed text-muted-soft">
            Only the checklist below prints. Navigation, illustrations and buttons are left out
            automatically.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The printable sheet -->
  <section id="sheet" class="section bg-surface-soft print-sheet">
    <div class="container-page">
      <div class="print-header hidden">
        <h2 class="display-md">Hospital Bag Checklist</h2>
        <p class="mt-1 text-sm text-muted">
          {totalItems} items for mom, baby and dad · {SITE.domain}
        </p>
      </div>

      <div class="no-print">
        <SectionHeader
          eyebrow="The full list"
          title="Hospital bag checklist for mom, baby and dad"
          lead="Every item, grouped by who it belongs to, with suggested quantities for a typical two to three night stay. Tick the boxes with a pen once it is printed."
        />
      </div>

      <div class="mt-12 space-y-8 print:mt-4">
        {
          sheets.map((sheet) => (
            <div class="print-section">
              <h3 class="display-sm border-b border-hairline pb-3">{sheet.heading}</h3>

              <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {sheet.groups.map((group) => (
                  <div class="print-section break-inside-avoid">
                    <p class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-muted">
                      {group.title}
                    </p>
                    <ul class="mt-3 space-y-2">
                      {group.items.map((item) => (
                        <li class="flex items-start gap-2.5">
                          <span
                            class="mt-[0.2rem] inline-block h-4 w-4 shrink-0 rounded-[5px] border-[1.5px] border-muted-soft"
                            aria-hidden="true"
                          />
                          <span class="text-sm leading-snug text-body-strong">
                            {item.name}
                            {item.qty && <span class="text-muted"> · {item.qty}</span>}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <div class="print-section">
          <h3 class="display-sm border-b border-hairline pb-3">Questions for your hospital</h3>
          <ul class="mt-6 grid gap-2 md:grid-cols-2">
            {
              HOSPITAL_QUESTIONS.map((entry) => (
                <li class="flex items-start gap-2.5">
                  <span
                    class="mt-[0.2rem] inline-block h-4 w-4 shrink-0 rounded-[5px] border-[1.5px] border-muted-soft"
                    aria-hidden="true"
                  />
                  <span class="text-sm leading-snug text-body-strong">{entry.question}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="print-footer mt-10 hidden text-xs text-muted-soft">
        Not medical advice. Always follow the guidance of your doctor, midwife or maternity unit.
        {SITE.domain}
      </p>

      <div class="mt-12 no-print">
        <button type="button" class="btn-primary" data-print-checklist>
          Print this checklist
        </button>
      </div>
    </div>
  </section>
</ContentPage>

<style>
  @media print {
    .print-header,
    .print-footer {
      display: block !important;
    }

    .print-sheet {
      padding: 0 !important;
      background: none !important;
    }

    .break-inside-avoid {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll('[data-print-checklist]')) {
    button.addEventListener('click', () => window.print());
  }
</script>
