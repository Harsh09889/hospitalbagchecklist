---
import ContentPage from '../layouts/ContentPage.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import PackGroupCard from '../components/marketing/PackGroupCard.astro';
import PrintableBand from '../components/marketing/PrintableBand.astro';
import LaborKit from '../components/illustrations/LaborKit.astro';
import { ROUTES } from '../config/site';
import {
  MOM_GROUPS,
  BABY_GROUPS,
  DAD_GROUPS,
  DOCUMENT_GROUP,
} from '../data/content/checklists';
import { MOM_AND_BABY_FAQS } from '../data/content/faqs';

const allGroups = [...MOM_GROUPS, ...BABY_GROUPS, ...DAD_GROUPS, DOCUMENT_GROUP];

const count = (groups: typeof MOM_GROUPS) =>
  groups.reduce((sum, group) => sum + group.items.length, 0);

const bags = [
  {
    name: 'Labor bag',
    who: 'Stays with mom',
    items: MOM_GROUPS[0]!.items.length,
    body: 'Small, carried into the delivery room. Documents, one loose thing to wear, socks, water and a long charger.',
    accent: 'bg-brand-coral text-on-coral',
    href: ROUTES.labor.path,
  },
  {
    name: "Mom's stay bag",
    who: 'Brought up after admission',
    items: MOM_GROUPS[1]!.items.length + MOM_GROUPS[2]!.items.length,
    body: 'Clothes, underwear, maternity pads, toiletries and the going-home outfit. Can wait in the car.',
    accent: 'bg-brand-lavender text-on-lavender',
    href: ROUTES.mom.path,
  },
  {
    name: 'Baby bag',
    who: 'Kept together, clearly labelled',
    items: count(BABY_GROUPS),
    body: 'Bodysuits, sleepsuits, muslins, swaddles and the going-home outfit. Car seat goes in the car, not the bag.',
    accent: 'bg-brand-butter text-on-butter',
    href: ROUTES.baby.path,
  },
  {
    name: "Dad's bag",
    who: 'Carried by the birth partner',
    items: count(DAD_GROUPS),
    body: 'Paperwork, chargers, wallet, snacks, a change of clothes and toiletries. A backpack works best.',
    accent: 'bg-brand-sky text-on-sky',
    href: ROUTES.dad.path,
  },
];

const contents = [
  { label: 'How the bags split', href: '#split' },
  { label: "Mom's list", href: '#mom' },
  { label: "Baby's list", href: '#baby' },
  { label: "Dad's list", href: '#dad' },
  { label: 'Documents', href: '#documents' },
  { label: 'FAQs', href: '#faq' },
];
---

<ContentPage
  routeKey="momAndBaby"
  h1="Hospital Bag Checklist for Mom, Baby and Dad"
  lead="One bag. Three people. Zero guesswork. This combined hospital bag checklist for mom and baby brings everything into one place, including a separate list for dad and birth partners so everyone knows what to bring."
  groups={allGroups}
  faqs={MOM_AND_BABY_FAQS}
  related={['mom', 'baby', 'dad']}
  contents={contents}
  ctaTitle="One checklist, four bags"
  ctaLead="Build a personalised version that splits every item into the right bag, with quantities based on your delivery plan and length of stay."
>
  <LaborKit slot="illustration" class="w-full max-w-md lg:ml-auto" />

  <section id="split" class="section">
    <div class="container-page">
      <div class="prose-clay mx-auto max-w-[45rem]">
        <h2>How to split the bags between you</h2>
        <p>
          The single most useful decision you can make is not <em>what</em> to pack but
          <strong>where each thing lives</strong>. One enormous bag means unpacking everything to
          find a phone charger. Four modest bags means anyone in the room can find what you need
          without asking.
        </p>
        <p>
          Below is the split most parents settle on. It works because it matches the order things
          actually get used: labor first, then the ward, then the trip home.
        </p>
      </div>

      <ul class="mt-14 grid gap-4 sm:grid-cols-2">
        {
          bags.map((bag) => (
            <li class={`card-feature reveal flex flex-col ${bag.accent}`}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-[0.14em] opacity-75">
                    {bag.who}
                  </span>
                  <h3 class="mt-2 font-display text-2xl font-medium">{bag.name}</h3>
                </div>
                <span class="shrink-0 rounded-full bg-canvas-pure/35 px-3 py-1 text-xs font-semibold">
                  {bag.items} items
                </span>
              </div>
              <p class="mt-4 flex-1 leading-relaxed opacity-90">{bag.body}</p>
              <a href={bag.href} class="btn-on-color mt-7 self-start">
                See the full list
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="prose-clay mx-auto mt-14 max-w-[45rem]">
        <h3>Label them, and say it out loud</h3>
        <p>
          Write on the bags, or use different colours. Then, sometime around 36 weeks, walk your
          partner through them. Not a formal handover — just five minutes of &ldquo;documents are in
          this front pocket, baby clothes are in the yellow bag&rdquo;. That conversation is worth
          more than anything else on this page.
        </p>
      </div>
    </div>
  </section>

  <section id="mom" class="section bg-surface-soft">
    <div class="container-page">
      <SectionHeader
        eyebrow={`For mom · ${count(MOM_GROUPS)} items`}
        title="What mom needs"
        lead="Split across labor, the hospital stay and going home. Quantities suit a typical two to three night stay."
      />
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {MOM_GROUPS.map((group, index) => <PackGroupCard group={group} index={index + 1} />)}
      </div>
      <a href={ROUTES.mom.path} class="btn-secondary mt-8">
        Read the full checklist for mom
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section id="baby" class="section">
    <div class="container-page">
      <SectionHeader
        eyebrow={`For baby · ${count(BABY_GROUPS)} items`}
        title="What baby needs"
        lead="Clothes, care items and the trip home. Check which of these your hospital already provides before you buy anything bulky."
      />
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {BABY_GROUPS.map((group, index) => <PackGroupCard group={group} index={index + 1} />)}
      </div>
      <a href={ROUTES.baby.path} class="btn-secondary mt-8">
        Read the full baby checklist
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section id="dad" class="section bg-surface-soft">
    <div class="container-page">
      <SectionHeader
        eyebrow={`For dad · ${count(DAD_GROUPS)} items`}
        title="What dad needs"
        lead="Enough to stay comfortable, connected and useful through a long day — and possibly a long night."
      />
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {DAD_GROUPS.map((group, index) => <PackGroupCard group={group} index={index + 1} />)}
      </div>
      <a href={ROUTES.dad.path} class="btn-secondary mt-8">
        Read the full checklist for dad
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section id="documents" class="section">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-16">
        <SectionHeader
          eyebrow="Shared"
          title="One folder for all your documents"
          lead="Documents belong to both of you, so keep them in one place rather than splitting them between bags. The birth partner usually carries the folder."
        />
        <PackGroupCard group={DOCUMENT_GROUP} />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <PrintableBand />
    </div>
  </section>
</ContentPage>
